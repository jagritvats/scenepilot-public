# ---- Google (Gemini via google-adk / google-genai) ----
# Option A: Gemini Developer API key
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_GENAI_USE_ENTERPRISE=TRUE   # newer ADK name for the same switch
# Option B: Vertex AI (set GOOGLE_GENAI_USE_VERTEXAI=TRUE and use ADC / gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# ---- Parallel (Search API) ----
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=advanced   # turbo | fast | basic | advanced
PARALLEL_MAX_CHARS_TOTAL=       # blank = let Parallel size excerpts for the client model (recommended)

# ---- Parallel: deep integrations (Task / FindAll / Memory) ----
# All OFF by default. These calls cost more or take longer than a Search, so they never fire
# implicitly: each one is reached from an explicit button that shows its cost before the click.
# SCENEPILOT_PARALLEL_MEMORY=1     # Production brain: read/evict what Task+Monitor+FindAll runs learned. No per-call cost.
# SCENEPILOT_PARALLEL_TASK=1       # Location dossiers via the Task API. ~$0.025 per location, 1–5 min.
# SCENEPILOT_PARALLEL_FINDALL=1    # Substitute vendors via FindAll / Entity Search. ~$0.005–$0.50 per run.
# PARALLEL_MEMORY_SCOPE_PREFIX=scenepilot   # memory scope = <prefix>_<project_id>
# PARALLEL_TASK_PROCESSOR=core-fast         # lite | base | core | core-fast | pro …
# PARALLEL_TASK_TIMEOUT_S=600
# PARALLEL_TASK_MAX_RUNS=4                  # per-request budget guard
# PARALLEL_FINDALL_MODE=entity_search       # entity_search (sync, 1-5 s) | findall (async, 5-10 min)
# PARALLEL_FINDALL_GENERATOR=base
# PARALLEL_FINDALL_MATCH_LIMIT=8            # FindAll accepts 5-1000 (clamped); Entity Search has no floor
# PARALLEL_FINDALL_TIMEOUT_S=300            # bound on polling a FindAll run; partial results are returned
# PARALLEL_FINDALL_ENRICH=1                 # deep FindAll only: fetch phone/address/day rate for matches

# ---- ScenePilot: irreversible production writes ----
# Not a spend gate - these cost nothing and call nobody. They are the two writes a producer cannot
# take back from the UI, and they default the OPPOSITE way to the Parallel flags above, for the
# opposite reason: those are off until someone chooses to spend, these are on because a local clone
# owns its own database. `deploy/cloudrun.sh` closes both on the hosted demo, which sits on a public
# page with no auth.
SCENEPILOT_ALLOW_WRAP=1            # close a shoot day out. A wrapped day is a record: it cannot be
                                   # rescued, re-timed or re-wrapped, and only a reset undoes it.
SCENEPILOT_ALLOW_COMMIT_BOARD=0    # keep a hand-edited stripboard over the engine's own schedule,
                                   # re-validated under the pack in force but never proposed by it.

# ---- ScenePilot ----
SCENEPILOT_MODE=live            # live | replay   (replay uses recordings captured from real runs)
SCENEPILOT_RECORD=0             # 1 = save live responses as replay recordings
SCENEPILOT_FALLBACK_TO_RECORDING=1  # live call failed → serve the matching recording, labelled replayed (demo hardening)
SCENEPILOT_WARM_DEMO=1          # seed a fresh project with the hero screenplay and the recorded location
                                # dossiers (labelled replayed, nothing accepted), so a cold instance is not
                                # an empty room. 0 = start blank and click everything yourself.
DATABASE_URL=                   # empty = sqlite at services/agent/data/scenepilot.db ; e.g. postgresql+psycopg://user:pw@host/db
AGENT_PORT=8000

# ---- Web ----
AGENT_URL=http://localhost:8000  # used by Next.js rewrites to proxy /api/* to the agent service
